{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Server: 开服",
      "type": "shell",
      "command": "cmd",
      "args": ["/d", "/c", "shell\\start.bat"],
      "options": {
        "cwd": "${workspaceFolder}\\Server"
