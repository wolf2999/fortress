{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Server: 开服",
      "type": "shell",
      "command": "cmd",
      "args": ["/d", "/c", "shell\\start.bat"],
      "options": {
        "cwd": "${workspaceFolder}\\Server"
      },
      "detail": "启动 db / gate / login / world，并在这个终端实时显示四份日志",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "Server: 关服",
      "type": "shell",
      "command": "cmd",
      "args": ["/d", "/c", "shell\\stop.bat", "all"],
      "options": {
        "cwd": "${workspaceFolder}\\Server"
      },
      "detail": "结束本机全部 skynet.exe，包括其他工程",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "close": false
      },
      "problemMatcher": []
    },
    {
      "label": "远程服务器状态",
      "type": "shell",
      "command": "node test\\remote_status.mjs",
      "options": {
        "cwd": "${workspaceFolder}\\Server"
      },
      "detail": "远程 Mac mini fortress-server：四份 App 日志尾部 + 8200-8204 端口监听 + 进程",
      "problemMatcher": []
    },
    {
      "label": "远程服务器日志(实时)",
      "type": "shell",
      "command": "node test\\remote_log.mjs",
      "options": {
        "cwd": "${workspaceFolder}\\Server"
      },
      "detail": "远程四份 App 日志实时滚动（Ctrl+C 退出）",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "远程发布(--auto)",
      "type": "shell",
      "command": "npm run deploy:auto",
      "options": {
        "cwd": "${workspaceFolder}\\Server"
      },
      "detail": "上传源码→远程编译 skynet→重启并校验（无人值守）",
      "problemMatcher": []
    },
    {
      "label": "数据库隧道(3307)",
      "type": "shell",
      "command": "ssh -N -L 3307:127.0.0.1:3306 123@10.10.100.85",
      "detail": "SSH 隧道：本地 3307 → 远程 MySQL 3306（root/123456，库 fortress）",
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
